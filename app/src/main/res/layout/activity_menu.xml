<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/Santri"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="23dp"
            android:src="@drawable/santri" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:layout_marginStart="23dp"
            android:text="Santri" />

        <ImageView
            android:id="@+id/guru"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="23dp"
            android:src="@drawable/guru" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:layout_marginStart="23dp"
            android:text="Guru" />

        <ImageView
            android:id="@+id/pelajaran"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="23dp"
            android:src="@drawable/pelajaran" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:layout_marginStart="23dp"
            android:text="Pelajaran" />

        <ImageView
            android:id="@+id/semester"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="23dp"
            android:src="@drawable/semester" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:layout_marginStart="23dp"
            android:text="Semester" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <ImageView
            android:id="@+id/orangtua"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="230dp"
            android:src="@drawable/ortu" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:layout_marginStart="230dp"
            android:text="Orangtua" />

        <ImageView
            android:id="@+id/kelas"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/kelas"
            android:layout_marginStart="230dp"/>

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="Kelas"
            android:layout_marginStart="230dp"/>

        <ImageView
            android:id="@+id/tahunajaran"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/tahun"
            android:layout_marginStart="230dp"/>

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="Tahun"
            android:layout_marginStart="230dp"/>
        <ImageView
            android:id="@+id/setting"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="230dp"
            android:src="@drawable/setting"/>

        <TextView
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:layout_marginStart="230dp"
            android:text="Setting" />



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




